<?xml version="1.0" encoding="utf-8"?>
<!-- דוח בוקר: a pill-shaped bar - the ITASK mark, the title and today's line -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itask_assistant_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="56dp"
    android:layout_margin="4dp"
    android:background="@drawable/itask_assistant_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="14dp">

    <ImageView
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@string/itask_assistant_label"
        android:scaleType="fitCenter"
        android:src="@drawable/itask_assistant_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/itask_morning_title"
            android:textColor="#202124"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itask_morning_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/itask_assistant_hint"
            android:textColor="#5f6368"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
