<?xml version="1.0" encoding="utf-8"?>
<!-- עוזר ITASK: a pill-shaped bar like Google's - the ITASK mark, the
     prompt, and a microphone at the other end -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itask_assistant_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="56dp"
    android:layout_margin="4dp"
    android:background="@drawable/itask_assistant_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="6dp">

    <ImageView
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@string/itask_assistant_label"
        android:scaleType="fitCenter"
        android:src="@drawable/itask_assistant_logo" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/itask_assistant_hint"
        android:textColor="#5f6368"
        android:textSize="17sp" />

    <ImageView
        android:id="@+id/itask_assistant_mic"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:contentDescription="@string/itask_assistant_mic"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/itask_assistant_mic" />
</LinearLayout>
