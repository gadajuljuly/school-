<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/itask_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/itask_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/itask_widget_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#35618F"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itask_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="המשימות שלי"
            android:textColor="#35618F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itask_widget_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#918A78"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/itask_widget_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#35618F"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/itask_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/itask_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="אין משימות פתוחות"
        android:textColor="#918A78"
        android:textSize="14sp" />
</LinearLayout>
