<?xml version="1.0" encoding="utf-8"?>
<!-- the floating task (ItaskFloatReceiver): a construction machine (a Lottie
     animation, a different one each time) drives across the screen from
     right to left, pulling the card - "project: task", the ITASK mark at its
     start, cream with a gold border - on a short chain behind it.
     The animations' canvas has room above and behind the machine for its
     smoke (320 x 320, the machine in the 256 x 256 at its bottom left): the
     view is 105dp so the machine stays 84dp, and the chain and the card sit
     21dp lower / further in to stay at its back, as before. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="6dp">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/itask_float_vehicle"
        android:layout_width="105dp"
        android:layout_height="105dp"
        android:contentDescription="@null" />

    <View
        android:id="@+id/itask_float_chain"
        android:layout_width="22dp"
        android:layout_height="4dp"
        android:layout_marginStart="-35dp"
        android:layout_marginTop="35dp"
        android:background="@drawable/itask_float_chain" />

    <LinearLayout
        android:id="@+id/itask_float_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:background="@drawable/itask_float_bg"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/itask_assistant_logo" />

        <TextView
            android:id="@+id/itask_float_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxWidth="250dp"
            android:singleLine="true"
            android:textColor="#2c2a24"
            android:textDirection="firstStrongRtl"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
