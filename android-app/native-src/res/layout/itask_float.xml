<?xml version="1.0" encoding="utf-8"?>
<!-- the floating task (ItaskFloatReceiver): a construction machine (a Lottie
     animation, a different one each time) drives across the screen from
     right to left, pulling the card - "project: task", the ITASK mark at its
     start, cream with a gold border - on a short chain behind it.
     The animations' canvas has room above and behind the machine for its
     smoke (320 x 320, the machine in the 256 x 256 at its bottom left): the
     view is 113dp (the machine 90dp). Everything is placed from the top
     (gravity top: a child's top = its marginTop) - the chain at the
     machine's back, 150 of its 256 down (75.6dp), the 38dp card centred on
     it. The workers style (ItaskFloatReceiver.pullWithRope) sets its own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="6dp">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/itask_float_vehicle"
        android:layout_width="113dp"
        android:layout_height="113dp"
        android:contentDescription="@null" />

    <View
        android:id="@+id/itask_float_chain"
        android:layout_width="22dp"
        android:layout_height="4dp"
        android:layout_marginStart="-38dp"
        android:layout_marginTop="74dp"
        android:background="@drawable/itask_float_chain" />

    <LinearLayout
        android:id="@+id/itask_float_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="57dp"
        android:background="@drawable/itask_float_bg"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/itask_assistant_logo" />

        <TextView
            android:id="@+id/itask_float_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxWidth="250dp"
            android:singleLine="true"
            android:textColor="#2c2a24"
            android:textDirection="firstStrongRtl"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- the worker style only: a second worker pushing the card from behind
         (94.5dp - 10% smaller than the puller; his palms at 10, 76 of the
         320 x 320 canvas: 3dp in, 22.4dp down - from 22dp down they're
         at 44dp, the card's upper half) -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/itask_float_pusher"
        android:layout_width="94.5dp"
        android:layout_height="94.5dp"
        android:layout_marginStart="-3dp"
        android:layout_marginTop="22dp"
        android:contentDescription="@null"
        android:visibility="gone" />
</LinearLayout>
