<?xml version="1.0" encoding="utf-8"?>
<!-- the floating task (ItaskFloatReceiver): a construction machine (a Lottie
     animation, a different one each time) drives across the screen from
     right to left, pulling the card - "project: task", the ITASK mark at its
     start, cream with a gold border - on a short chain behind it.
     The machines' canvas has room above and behind for their coal-train
     smoke (576 x 406, the machine in the 256 x 256 at its bottom left): the
     view is 203 x 143dp (the machine 90dp). Everything is placed from the
     top (gravity top: a child's top = its marginTop) - the chain at the
     machine's back, 150 of its 256 down (105.7dp), the 38dp card centred on
     it. The workers style (ItaskFloatReceiver.pullWithRope) sets its own;
     the window is raised so the card is at the same height either way. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="6dp">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/itask_float_vehicle"
        android:layout_width="203dp"
        android:layout_height="143dp"
        android:contentDescription="@null" />

    <View
        android:id="@+id/itask_float_chain"
        android:layout_width="22dp"
        android:layout_height="4dp"
        android:layout_marginStart="-128dp"
        android:layout_marginTop="103.5dp"
        android:background="@drawable/itask_float_chain" />

    <LinearLayout
        android:id="@+id/itask_float_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="86.5dp"
        android:background="@drawable/itask_float_bg"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/itask_assistant_logo" />

        <TextView
            android:id="@+id/itask_float_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxWidth="250dp"
            android:singleLine="true"
            android:textColor="#2c2a24"
            android:textDirection="firstStrongRtl"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- the worker style only: a second worker pushing the card from behind
         (94.5dp, like the puller; his palms at 10, 76 of the 320 x 320
         canvas: 3dp in, 22.4dp down - from 14dp down they're at 36dp, the
         card's upper part, his boots level with the puller's) -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/itask_float_pusher"
        android:layout_width="94.5dp"
        android:layout_height="94.5dp"
        android:layout_marginStart="-3dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@null"
        android:visibility="gone" />
</LinearLayout>
